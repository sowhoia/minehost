{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineHost",
  "version": "1.1.0",
  "identifier": "dev.minehost.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MineHost",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["minehost"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MkEzQUJBMDc4MTVFODEKUldTQlhvRUh1am9xeGNBYkFEOUlXQjZ5VnJSL0VEdERrNzJEdU1rSllNcnpabUFWU0lBOUdwYjgK",
      "endpoints": ["https://github.com/sowhoia/minehost/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
